====================================== */

/* Fireworks Screen */

#fireworksScreen{

display:none;

position:fixed;

top:0;

left:0;

width:100%;

height:100%;

background:linear-gradient(135deg,#2d0b59,#6a0dad,#9d4edd);

justify-content:center;

align-items:center;

flex-direction:column;

text-align:center;

z-index:9999;

padding:20px;

}

#fireworksScreen h1{

font-size:55px;

margin-bottom:20px;

animation:zoom 1s infinite alternate;

}

#fireworksScreen h2{

font-size:30px;

margin-bottom:15px;

}

#fireworksScreen p{

font-size:20px;

margin-bottom:30px;

}

/* Confetti */

.confetti{

position:fixed;

top:-20px;

width:12px;

height:12px;

border-radius:50%;

animation:fall linear forwards;

z-index:99999;

}

@keyframes fall{

0%{

transform:translateY(0) rotate(0);

opacity:1;

}

100%{

transform:translateY(110vh) rotate(720deg);

opacity:0;

}

}

/* Floating Hearts */

.heart{

position:fixed;

bottom:-40px;

animation:floatHeart 6s linear forwards;

pointer-events:none;

z-index:1000;

}

@keyframes floatHeart{

0%{

transform:translateY(0) scale(0.8);

opacity:1;

}

100%{

transform:translateY(-110vh) scale(1.8);

opacity:0;

}

}

/* Countdown */

#countdown{

font-size:30px;

font-weight:bold;

margin-top:20px;

text-align:center;

}

/* Quiz Buttons */

#options button{

margin:10px 0;

width:100%;

}

/* Final Card */

.final{

text-align:center;

}

.final h1{

font-size:45px;

margin-bottom:20px;

}

.final p{

font-size:20px;

line-height:1.8;

}

@keyframes zoom{

from{

transform:scale(1);

}

to{

transform:scale(1.08);

}

}

/* Mobile */

@media(max-width:768px){

header h1{

font-size:32px;

}

.glass h1{

font-size:34px;

}

.glass h2{

font-size:28px;

}

.card{

padding:20px;

}

button{

width:100%;

}

#fireworksScreen h1{

font-size:34px;

}

}
